<Window x:Class="音频可视化.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:音频可视化.ViewModels"
        xmlns:vis="clr-namespace:音频可视化"
        mc:Ignorable="d"
        Title="音频可视化" Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        Background="#0f0f1a"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#2d2d44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3d3d5c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4d4d6c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8888aa"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent"
                                CornerRadius="4" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3d3d5c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d2d44"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#16162a" BorderBrush="#2d2d44" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="打开文件"
                            Click="OpenFile_Click"
                            Margin="0,0,12,0"/>

                    <Button x:Name="PlayPauseBtn"
                            Style="{StaticResource ToolbarButton}"
                            Click="PlayPause_Click"
                            Margin="0,0,8,0"
                            Width="50">
                        <TextBlock x:Name="PlayPauseIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>

                    <Button Style="{StaticResource ToolbarButton}"
                            Content="停止"
                            Click="Stop_Click"
                            Margin="0,0,20,0"/>

                    <TextBlock x:Name="FileNameText"
                               Text="未加载文件"
                               Foreground="#8888aa"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="PositionText"
                               Text="00:00 / 00:00"
                               Foreground="#8888aa"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Visualization Area -->
        <Border Grid.Row="1" Background="#0f0f1a" Margin="16">
            <vis:DrawingCanvas x:Name="VisualizationCanvas" ClipToBounds="True"/>
        </Border>

        <!-- Bottom Controls -->
        <Border Grid.Row="2" Background="#16162a" BorderBrush="#2d2d44" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Position Slider -->
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="PositionSlider"
                            Grid.Column="0"
                            Minimum="0"
                            Maximum="100"
                            Height="20"
                            VerticalAlignment="Center"
                            ValueChanged="PositionSlider_ValueChanged"/>

                    <TextBlock Grid.Column="1"
                               Text="音量"
                               Foreground="#8888aa"
                               VerticalAlignment="Center"
                               Margin="20,0,8,0"/>

                    <Slider x:Name="VolumeSlider"
                            Grid.Column="2"
                            Minimum="0"
                            Maximum="100"
                            Value="80"
                            Height="20"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </Grid>

                <!-- Mode Selection -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <RadioButton x:Name="BarMode"
                                 Style="{StaticResource ModeRadio}"
                                 Content="频谱柱状图"
                                 IsChecked="True"
                                 Checked="VisualizationMode_Changed"/>
                    <RadioButton x:Name="CircularMode"
                                 Style="{StaticResource ModeRadio}"
                                 Content="圆形效果"
                                 Checked="VisualizationMode_Changed"/>
                    <RadioButton x:Name="ParticleMode"
                                 Style="{StaticResource ModeRadio}"
                                 Content="粒子系统"
                                 Checked="VisualizationMode_Changed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
